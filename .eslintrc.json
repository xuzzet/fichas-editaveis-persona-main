{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "worker": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "extends": "eslint:recommended",
  "globals": {
    "PDFLib": "readonly",
    "html2canvas": "readonly"
  },
  "rules": {
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-empty": ["warn", { "allowEmptyCatch": true }],
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["tests/**/*.js"],
      "env": { "node": true },
      "globals": {
        "describe": "readonly",
        "it": "readonly",
        "expect": "readonly"
      }
    }
  ]
}
